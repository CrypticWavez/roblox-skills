for id, preset in PRESETS do
	preset.id = id
end

local function copy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for key, child in value do
		out[key] = copy(child)
	end
	return out
end

-- Sorted preset ids.
function VfxLibrary.list(): { string }
	local ids = {}
	for id in PRESETS do
		table.insert(ids, id)
	end
	table.sort(ids)
	return ids
end

-- A deep copy of one preset (callers may tweak it); raises on an unknown id.
function VfxLibrary.get(id: string): any
	local preset = PRESETS[id]
	assert(preset ~= nil, "VfxLibrary: unknown preset " .. tostring(id))
	return copy(preset)
end

-- Every preset as a deep copy, keyed by id.
function VfxLibrary.all(): { [string]: any }
	return copy(PRESETS)
end

return VfxLibrary
