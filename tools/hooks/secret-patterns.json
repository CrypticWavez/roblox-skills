{
  "_comment": "Single source of credential patterns for tools/check.py (secret-scan) and tools/hooks/fast_on_edit.mjs. Patterns must be valid in both JavaScript and Python regex syntax; flags may contain only 'i'. tools/hooks/selftest.mjs checks both engines agree on a sample of each.",
  "patterns": [
    { "label": "Roblox .ROBLOSECURITY cookie", "pattern": "_\\|WARNING:-DO-NOT-SHARE-THIS", "flags": "" },
    { "label": "Roblox Open Cloud API key", "pattern": "x-api-key[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9+/=_-]{40,}", "flags": "i" },
    { "label": "Roblox Open Cloud API key", "pattern": "(?:roblox|rbx|open_?cloud)[A-Za-z0-9_]*key[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9+/=_-]{40,}", "flags": "i" },
    { "label": "Roblox Open Cloud API key", "pattern": "--api-key[\\s=][\"']?[A-Za-z0-9+/=_-]{40,}", "flags": "i" },
    { "label": "private key", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY( BLOCK)?-----", "flags": "" },
    { "label": "GitHub token", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,}", "flags": "" },
    { "label": "Anthropic API key", "pattern": "\\bsk-ant-[A-Za-z0-9_-]{20,}", "flags": "" },
    { "label": "OpenAI API key", "pattern": "\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{32,}", "flags": "" },
    { "label": "AWS access key", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b", "flags": "" },
    { "label": "AWS secret key", "pattern": "aws_secret_access_key[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{40}", "flags": "i" },
    { "label": "Slack token", "pattern": "\\bxox[abprsec]-[A-Za-z0-9-]{10,}", "flags": "" },
    { "label": "Slack webhook", "pattern": "https://hooks\\.slack\\.com/services/T[A-Za-z0-9]+/B[A-Za-z0-9]+/[A-Za-z0-9]{20,}", "flags": "" },
    { "label": "Google API key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b", "flags": "" }
  ]
}
