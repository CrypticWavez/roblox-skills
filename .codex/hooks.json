{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/guard_bash.mjs\" --client=codex",
            "commandWindows": "node tools/hooks/guard_bash.mjs --client=codex",
            "timeout": 10,
            "statusMessage": "Factory guard: shell command"
          }
        ]
      },
      {
        "matcher": "^mcp__(Roblox_Studio|blender\\w*)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/guard_mcp.mjs\" --client=codex",
            "commandWindows": "node tools/hooks/guard_mcp.mjs --client=codex",
            "timeout": 10,
            "statusMessage": "Factory guard: Studio/Blender MCP tool"
          }
        ]
      }
    ]
  }
}
