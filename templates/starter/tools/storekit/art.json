{
  "schema": "store-art/1",
  "note": "Store-art specs and compositing templates for tools/store_art.py. Specs from Roblox's docs (experience-icons, thumbnails, passes, developer-products, badges; fetched 2026-10-07, factory docs/research/monetization-ads-store-2026-10.md); 'verified': false marks community heuristics. Template boxes are fractions of the canvas [x, y, w, h]. Fonts are fetched by `store_art.py fonts --fetch` (SIL OFL, pinned sha256) into assets/fonts/.",
  "specs": {
    "icon": {"width": 512, "height": 512, "exact": true, "formats": ["png", "jpg"], "max_bytes": null, "shown_at": [150, 64], "crop": "rounded_square", "safe_inset": 0.08, "max_words": 3, "source": "https://create.roblox.com/docs/production/publishing/experience-icons", "verified": true},
    "thumbnail": {"width": 1920, "height": 1080, "aspect": [16, 9], "min_width": 1280, "formats": ["jpg", "png", "gif", "tga", "bmp"], "max_bytes": 3000000, "max_count": 10, "personalization": [2, 5], "bottom_no_text": 0.2, "side_margin": 0.05, "max_words": 6, "shown_at": [480, 270], "source": "https://create.roblox.com/docs/production/publishing/thumbnails", "verified": true},
    "pass": {"width": 512, "height": 512, "max_size": true, "formats": ["png", "jpg", "bmp"], "crop": "circle", "circle_safe": 0.9, "max_words": 2, "source": "https://create.roblox.com/docs/production/monetization/passes", "verified": true},
    "product": {"width": 512, "height": 512, "max_size": true, "formats": ["png", "jpg", "bmp"], "crop": "circle", "circle_safe": 0.9, "max_words": 2, "source": "https://create.roblox.com/docs/production/monetization/developer-products", "verified": true},
    "badge": {"width": 512, "height": 512, "exact": true, "formats": ["png", "jpg"], "crop": "circle", "circle_safe": 0.9, "max_words": 2, "source": "https://create.roblox.com/docs/production/publishing/badges", "verified": true},
    "ad": {"width": 1920, "height": 1080, "aspect": [16, 9], "min_width": 1280, "formats": ["jpg", "png", "gif", "tga", "bmp"], "max_bytes": 3000000, "bottom_no_text": 0.2, "side_margin": 0.05, "max_words": 6, "shown_at": [480, 270], "source": "https://create.roblox.com/docs/production/promotion/ads-manager", "verified": true}
  },
  "heuristics": {
    "min_saturation": 0.35,
    "min_luma_std": 0.18,
    "max_edge_density": 0.25,
    "max_outside_circle_energy": 0.05,
    "note": "Community heuristics for small-size readability (bright, high-contrast, one focal point). Horror games may waive saturation (--genre-mood dark)."
  },
  "fonts": [
