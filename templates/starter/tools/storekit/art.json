  },
  "thumbnail_concepts": [
    {"id": "hero", "template": "thumbnail_hero", "concept": "The mascot or main character close up, big emotion (shock, joy, determination), looking at the biggest reward of the game; title on the left.", "why": "Faces with strong emotion and one focal point read first on a small tile."},
    {"id": "core_action", "template": "thumbnail_action", "concept": "The core loop's most exciting moment in-game (the big hit, the rare drop, the boss), camera low and close, motion lines.", "why": "Shows what the player will do; accurate gameplay keeps first-play bounce low (a Home ranking signal)."},
    {"id": "reward", "template": "thumbnail_hero", "concept": "The rarest item, pet or unit glowing on a pedestal with sparkles, the character reaching for it.", "why": "Aspiration: the thing players chase; strong in collection, RNG and simulator genres."},
    {"id": "social", "template": "thumbnail_action", "concept": "Three or four avatars together mid-action (team win, party, roleplay scene), varied avatars, bright set.", "why": "Co-play is a ranking signal; shows the game is better with friends."},
    {"id": "update", "template": "thumbnail_hero", "concept": "The newest update's feature (new world, boss, event) with a ribbon naming it.", "why": "Returning players click on visible newness; rotate it in with each update."}
  ]
}
