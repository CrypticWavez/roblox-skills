    {"name": "Titan One", "file": "TitanOne-Regular.ttf", "license": "OFL-1.1", "url": "https://raw.githubusercontent.com/google/fonts/main/ofl/titanone/TitanOne-Regular.ttf", "sha256": "563ff6de179bbd44bcd7d2a6c448d6dc3bf935834237cf1250e506e65cd86ff1", "use": "chunky cartoon titles (simulators, tycoons, pets)"},
    {"name": "Bangers", "file": "Bangers-Regular.ttf", "license": "OFL-1.1", "url": "https://raw.githubusercontent.com/google/fonts/main/ofl/bangers/Bangers-Regular.ttf", "sha256": "4160a7311de9342674cce9160cde9fcbb30f48190397d86ff1b70b455af65824", "use": "comic action (battlegrounds, anime, fighting)"},
    {"name": "Russo One", "file": "RussoOne-Regular.ttf", "license": "OFL-1.1", "url": "https://raw.githubusercontent.com/google/fonts/main/ofl/russoone/RussoOne-Regular.ttf", "sha256": "bc0abcc660bd8b7ad3000ecb2898a27c58a29a50f7ec81652fa12e75148d09df", "use": "squared tech (shooters, racing, sci-fi)"}
